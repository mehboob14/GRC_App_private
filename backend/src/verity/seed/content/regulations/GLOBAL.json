  {
    "key": "GL-01",
    "jurisdiction": "GLOBAL",
    "zone": null,
    "short_name": "PCI DSS",
    "official_name": "Payment Card Industry Data Security Standard (PCI DSS) v4.0.1",
    "issuer": "PCI Security Standards Council",
    "regulator": "Card brands and acquiring banks, by contract",
    "kinds": [
      "payments"
    ],
    "topic_column": "sector",
    "force": "contract_standard",
    "state": "in_force",
    "state_note": "Contractual standard. v4.0.1 has been the only active version since 31 December 2024 and its future-dated requirements became mandatory on 31 March 2025; the Council consulted on the next version in mid 2026 and none is announced.",
    "tier": "sector",
    "applies_to": "Any entity that stores, processes or transmits payment card account data or can affect its security: merchants, service providers and payment SaaS.",
    "duties": [
      {
        "topic": "baseline",
        "text": "Meet the 12 requirement families, and shrink scope with tokenisation or hosted payment pages.",
        "clock_hours": null
      },
      {
        "topic": "baseline",
        "text": "Use MFA for all access to the cardholder data environment and manage scripts on payment pages.",
        "clock_hours": null
      },
      {
        "topic": "assessment",
        "text": "Run targeted risk analyses and annual penetration tests.",
        "clock_hours": null
      },
      {
        "topic": "assessment",
        "text": "Validate by self-assessment questionnaire or, for larger volumes and service providers, a Report on Compliance by a Qualified Security Assessor with an Attestation of Compliance.",
        "clock_hours": null
      },
      {
        "topic": "assessment",
        "text": "Get quarterly external scans from an approved scanning vendor.",
        "clock_hours": null
      }
    ],
    "assurance": {
      "kind": "attestation",
      "note": "Self-assessment questionnaire or a Report on Compliance by a Qualified Security Assessor, with an Attestation of Compliance."
    },
    "iso27001": {
      "relation": "not_a_substitute",
      "note": "Not a substitute. The Council publishes a mapping of PCI DSS v4.0.1 to NIST CSF 2.0."
    },
