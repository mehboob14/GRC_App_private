    "tier": "sector",
    "applies_to": "Every organisation connected to the SWIFT network: banks, some corporates and service bureaus.",
    "duties": [
      {
        "topic": "baseline",
        "text": "Secure and segregate the SWIFT environment and reduce its attack surface.",
        "clock_hours": null
      },
      {
        "topic": "baseline",
        "text": "Manage credentials and privileges, and detect anomalous activity.",
        "clock_hours": null
      },
      {
        "topic": "baseline",
        "text": "Secure back office data flows, which are becoming mandatory in phases.",
        "clock_hours": null
      },
      {
        "topic": "incident_reporting",
        "text": "Plan and run incident response for the SWIFT environment.",
        "clock_hours": null
      },
      {
        "topic": "assessment",
        "text": "Attest every year in the KYC Security Attestation application, backed by an independent internal or external assessment; counterparties and regulators can see non-compliance.",
        "clock_hours": null
      }
    ],
    "assurance": {
      "kind": "attestation",
      "note": "Annual attestation supported by an independent internal or external assessment."
    },
    "iso27001": {
      "relation": "not_a_substitute",
      "note": "SWIFT maps the controls to ISO 27002, NIST and PCI DSS in the framework annex; certification alone does not satisfy the attestation."
    },
    "soc2": {
      "relation": "not_a_substitute",
      "note": "Does not satisfy the attestation."
    },
