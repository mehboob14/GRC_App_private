  {
    "key": "PK-07",
    "jurisdiction": "PK",
    "zone": null,
    "short_name": "PISF-2026 and CERT Rules",
    "official_name": "National Cyber Security Policy 2021, Computer Emergency Response Team Rules 2023 and Pakistan Information Security Framework 2026 (PISF-2026)",
    "issuer": "Ministry of Information Technology and Telecommunication (policy and notification); PKCERT (framework)",
    "regulator": "National CERT (PKCERT) and sectoral CERTs",
    "kinds": [
      "cybersecurity",
      "government_sector",
      "critical_infrastructure"
    ],
    "topic_column": "security_baseline",
    "force": "regulation",
    "state": "in_force_phasing",
    "state_note": "The policy and the CERT Rules (SRO 1394(I)/2023) are in force. MoITT's notification of 13 October 2026 made PISF-2026, approved by the Federal Cabinet on 10 August 2026, binding on the bodies in its scope, with 12, 15 or 18 month timelines whose start date is not stated.",
    "tier": "most_should_know",
    "applies_to": "Federal and provincial ministries, divisions and departments, autonomous bodies, state corporations, CERTs and designated critical information infrastructure. Private companies are not in scope unless designated as critical information infrastructure; suppliers are reached only through the supply chain controls of those bodies.",
    "duties": [
      {
        "topic": "baseline",
        "text": "Cover the 13 PISF control documents, from governance, asset and risk management and identity and access to incident response, supply chain and audit, plus critical infrastructure protection where designated.",
        "clock_hours": null
      },
      {
        "topic": "assessment",
        "text": "Self-assess maturity on eight parameters scored 0 to 3; the total sets a timeline of 12 months (Established), 15 months (Developing) or 18 months (Foundational).",
        "clock_hours": null
      },
      {
        "topic": "assessment",
        "text": "Large or constrained bodies may extend by three to six months on formal justification approved by their own executive authority, not by PKCERT.",
        "clock_hours": null
      },
      {
        "topic": "assessment",
        "text": "Record risk acceptance and target dates for deferred controls, and reassess gap closure and maturity periodically.",
        "clock_hours": null
      },
      {
        "topic": "incident_reporting",
        "text": "Report incidents to the relevant CERT under the CERT Rules 2023.",
        "clock_hours": null
      }
    ],
    "assurance": {
      "kind": "none",
      "note": "No certification scheme; bodies without in-house capacity may use PKCERT-authorised firms and accredited consultants."
    },
    "iso27001": {
      "relation": "helps_partially",
      "note": "Annex II counts formal adoption of ISO/IEC 27001 toward the maturity score, so it helps reach a shorter timeline tier; it does not replace the PISF controls."
    },
    "soc2": {
      "relation": "not_relevant",
      "note": "Not mentioned in PISF."
    },
