[
  {
    "key": "PK-01",
    "jurisdiction": "PK",
    "zone": null,
    "short_name": "PECA",
    "official_name": "Prevention of Electronic Crimes Act 2016, as amended by the Prevention of Electronic Crimes (Amendment) Act 2025",
    "issuer": "Parliament of Pakistan; Ministry of Information Technology and Telecommunication (MoITT)",
    "regulator": "Pakistan Telecommunication Authority (content) and the National Cyber Crime Investigation Agency (investigations)",
    "kinds": [
      "cybersecurity",
      "privacy"
    ],
    "topic_column": "security_baseline",
    "force": "law",
    "state": "in_force",
    "state_note": "In force. The 2025 amendment (Act No. II of 2025, assented 29 January 2025) added a false information offence and a social media regulator structure; it faces court challenges, but in February 2026 the Islamabad High Court said it cannot be suspended by injunction (press).",
    "tier": "most_should_know",
    "applies_to": "Every person and organisation in Pakistan, and offences against Pakistani systems or people committed from abroad. Telecoms, hosting providers and platforms carry specific service provider duties.",
    "duties": [
      {
        "topic": "baseline",
        "text": "Know the criminal offences for unauthorised access, data interference, electronic fraud and identity misuse.",
        "clock_hours": null
      },
      {
        "topic": "baseline",
        "text": "As a service provider, retain traffic data for at least one year.",
        "clock_hours": null
      },
      {
        "topic": "baseline",
        "text": "As a service provider, cooperate with authorised requests from investigators and keep them confidential.",
        "clock_hours": null
      },
      {
        "topic": "baseline",
        "text": "Expect PTA orders to remove or block unlawful online content.",
        "clock_hours": null
      },
      {
        "topic": "consent",
        "text": "Do not disclose identity or personal data without authorisation; it is an offence and the nearest thing to a privacy rule in force.",
        "clock_hours": null
      },
      {
        "topic": "penalties",
        "text": "The new false information offence carries up to three years in prison and a fine up to PKR 2 million.",
        "clock_hours": null
      }
    ],
    "assurance": {
      "kind": "none",
      "note": "No certification."
    },
    "iso27001": {
      "relation": "not_relevant",
      "note": "Not referenced."
    },
    "soc2": {
      "relation": "not_relevant",
      "note": "Not referenced."
    },
    "helps": [
      "LM-02",
      "LM-07",
      "CS-07",
      "DM-09",
      "GOV-05",
      "IAM-08"
    ],
    "not_covered": [
      "Service provider duties to keep traffic data and assist investigations, which need legal reading",
      "General data protection, since this is a cybercrime law and no data protection statute is in force"
    ],
    "framework_code": null,
