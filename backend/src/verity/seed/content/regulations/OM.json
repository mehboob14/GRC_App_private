[
  {
    "key": "OM-01",
    "jurisdiction": "OM",
    "zone": null,
    "short_name": "Oman PDPL",
    "official_name": "Personal Data Protection Law (Royal Decree 6/2022, amended by Royal Decree 68/2026) and Executive Regulations (Ministerial Decision 34/2024)",
    "issuer": "Sultanate of Oman (Royal Decree); MTCIT (Executive Regulations)",
    "regulator": "Ministry of Transport, Communications and Information Technology (MTCIT)",
    "kinds": [
      "privacy"
    ],
    "topic_column": "privacy",
    "force": "law",
    "state": "in_force",
    "state_note": "In force and in its enforcement phase since the two year compliance period ended on 5 February 2026. Royal Decree 68/2026, in force 7 September 2026, extended the law to processing of data about people in Oman wherever it happens.",
    "tier": "most_should_know",
    "applies_to": "Processing of personal data of natural persons in Oman, whether done inside or outside Oman, so foreign companies processing data of people in Oman are in scope. Excluded: national security and public interest processing, state bodies performing their legal functions, protecting the state's economic and financial interests, crime detection on a written request, purely personal or family use, and authorised research where no one can be identified.",
    "duties": [
      {
        "topic": "consent",
        "text": "Rely on explicit consent you can prove, including for direct marketing, unless one of the new grounds applies: a legal duty, lawfully public data, a vital interest or a contract the person is party to.",
        "clock_hours": null
      },
      {
        "topic": "registration",
        "text": "Get an MTCIT permit before processing sensitive data such as health, biometric or genetic data, except the new cases for employee data and official security camera footage.",
        "clock_hours": null
      },
      {
        "topic": "officer",
        "text": "Appoint a data protection officer and publish their contact details, and appoint a ministry-approved external auditor whose report reaches MTCIT within 60 days of appointment.",
        "clock_hours": null
      },
      {
        "topic": "breach_notice",
        "text": "Notify MTCIT within 72 hours of learning of a breach that may threaten people's rights, notify the people affected within 72 hours where harm may be serious, and keep a breach record.",
        "clock_hours": 72
      },
      {
        "topic": "transfers",
        "text": "Send data abroad only with explicit consent (limited exceptions), adequate protection and a documented transfer risk assessment.",
        "clock_hours": null
      },
      {
        "topic": "penalties",
        "text": "Fines run from OMR 500 to 2,000 for consent breaches up to OMR 100,000 to 500,000 for unlawful cross-border transfer, with OMR 5,000 to 100,000 for legal persons.",
        "clock_hours": null
      }
    ],
    "assurance": {
      "kind": "registration",
      "note": "No certification; sensitive data needs an MTCIT permit lasting up to five years, and the ministry approves the external auditors who assess compliance."
    },
    "iso27001": {
      "relation": "helps_partially",
      "note": "Not referenced; supports the security and confidentiality duties."
    },
    "soc2": {
      "relation": "helps_partially",
      "note": "Not referenced; supports the security and confidentiality duties."
    },
