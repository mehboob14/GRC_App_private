    "key": "UK-01",
    "jurisdiction": "GB",
    "zone": null,
    "short_name": "UK GDPR",
    "official_name": "UK GDPR, Data Protection Act 2018 and Data (Use and Access) Act 2025",
    "issuer": "UK Parliament",
    "regulator": "Information Commission (took over the Information Commissioner's Office functions on 30 September 2026)",
    "kinds": [
      "privacy"
    ],
    "topic_column": "privacy",
    "force": "law",
    "state": "in_force",
    "state_note": "In force. The Data (Use and Access) Act 2025 commenced in stages: most data protection changes on 5 February 2026, the complaints procedure duty on 19 June 2026 and regulator governance on 30 September 2026; the ICO has said all outstanding provisions are now in force.",
    "tier": "most_should_know",
    "applies_to": "Organisations established in the UK that process personal data, and organisations abroad that offer goods or services to, or monitor, people in the UK.",
    "duties": [
      {
        "topic": "registration",
        "text": "Pay the annual data protection fee to the regulator as a controller.",
        "clock_hours": null
      },
      {
        "topic": "breach_notice",
        "text": "Notify the regulator within 72 hours of a qualifying personal data breach.",
        "clock_hours": 72
      },
      {
        "topic": "officer",
        "text": "Appoint a data protection officer in the same cases as under the EU GDPR, and a UK representative if not established in the UK.",
        "clock_hours": null
      },
      {
        "topic": "transfers",
        "text": "Send personal data abroad only under UK adequacy regulations, the International Data Transfer Agreement or the UK Addendum.",
        "clock_hours": null
      },
      {
        "topic": "baseline",
        "text": "Run a data protection complaints procedure and acknowledge each complaint within 30 days.",
        "clock_hours": null
      },
      {
        "topic": "penalties",
        "text": "Fines reach GBP 17.5 million or 4 percent of turnover; the 2025 Act raised marketing and cookie (PECR) fines to the same scale.",
        "clock_hours": null
      }
    ],
    "assurance": {
      "kind": "registration",
      "note": "Controllers pay an annual data protection fee; approved certification schemes exist but are optional."
    },
    "iso27001": {
      "relation": "helps_partially",
      "note": "As for GDPR: supports the security principle, not proof of compliance."
    },
