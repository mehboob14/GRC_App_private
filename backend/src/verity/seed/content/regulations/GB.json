    "state": "in_force",
    "state_note": "The 2018 Regulations are in force. The Cyber Security and Resilience Bill, introduced 12 November 2025, reportedly finished Lords report stage on 26 October 2026; no Royal Assent was confirmed by 21 November 2026 and most duties will need secondary legislation.",
    "tier": "sector",
    "applies_to": "Today, operators of essential services (energy, transport, health, water, digital infrastructure) and relevant digital service providers (online marketplaces, search engines, cloud services) above small business size. The Bill would add managed service providers, data centres and designated critical suppliers.",
    "duties": [
      {
        "topic": "baseline",
        "text": "Take appropriate and proportionate security measures; regulators assess them with the NCSC Cyber Assessment Framework.",
        "clock_hours": null
      },
      {
        "topic": "incident_reporting",
        "text": "Report significant incidents within 72 hours.",
        "clock_hours": 72
      },
      {
        "topic": "penalties",
        "text": "Fines reach GBP 17 million under the current Regulations.",
        "clock_hours": null
      },
      {
        "topic": "incident_reporting",
        "text": "The Bill would require a 24 hour initial report and a 72 hour full report, customer notification, wider regulator powers and higher turnover-based penalties.",
        "clock_hours": null
      }
    ],
    "assurance": {
      "kind": "none",
      "note": "No certification; regulators use the NCSC Cyber Assessment Framework."
    },
    "iso27001": {
      "relation": "helps_partially",
      "note": "Not formally recognised; ISO 27001 maps reasonably to the Cyber Assessment Framework objectives."
    },
    "soc2": {
      "relation": "helps_partially",
      "note": "Not formally recognised by the regulators."
    },
