    "zone": null,
    "short_name": "FCA and PRA operational resilience",
    "official_name": "FCA SYSC 15A (PS21/3), PRA SS1/21 and SS2/21, and related critical third party and incident reporting rules",
    "issuer": "Financial Conduct Authority, Prudential Regulation Authority and Bank of England",
