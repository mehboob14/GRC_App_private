  {
    "key": "UK-03",
    "jurisdiction": "GB",
    "zone": null,
    "short_name": "Cyber Essentials",
    "official_name": "Cyber Essentials and Cyber Essentials Plus",
    "issuer": "National Cyber Security Centre (NCSC)",
    "regulator": "IASME, delivery partner for the NCSC",
    "kinds": [
      "cybersecurity"
    ],
    "topic_column": "security_baseline",
    "force": "voluntary_framework",
    "state": "voluntary",
    "state_note": "Voluntary, but contractually required for many central government contracts and Ministry of Defence suppliers. Requirements v3.3 and the Danzell question set apply to assessment accounts created after 26 April 2026.",
    "tier": "most_should_know",
    "applies_to": "Any organisation. Expected of suppliers handling government personal data or certain ICT services, and widely asked for in UK supply chains and by insurers.",
    "duties": [
      {
        "topic": "baseline",
        "text": "Cover the five control themes: firewalls, secure configuration, security update management, user access control and malware protection.",
        "clock_hours": null
      },
      {
        "topic": "baseline",
        "text": "Turn on MFA wherever a cloud service offers it; missing MFA on a cloud service is an automatic fail.",
        "clock_hours": null
      },
      {
        "topic": "baseline",
        "text": "Install high and critical security updates within 14 days.",
        "clock_hours": null
      },
      {
        "topic": "assessment",
        "text": "Keep cloud services in scope; they cannot be scoped out.",
        "clock_hours": null
      },
      {
        "topic": "assessment",
        "text": "Renew every year; Cyber Essentials Plus adds an independent technical test.",
        "clock_hours": null
      }
    ],
    "assurance": {
      "kind": "certification",
      "note": "Cyber Essentials is a verified self-assessment and Cyber Essentials Plus adds an independent technical test; both renew annually."
    },
    "iso27001": {
      "relation": "not_a_substitute",
      "note": "Separate and much narrower; ISO 27001 does not exempt a supplier from a Cyber Essentials contract clause."
    },
    "soc2": {
      "relation": "not_a_substitute",
      "note": "A Cyber Essentials contract clause asks for the certificate itself."
    },
