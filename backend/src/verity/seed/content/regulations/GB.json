        "topic": "assessment",
        "text": "Identify important business services, set impact tolerances and test them.",
        "clock_hours": null
      },
      {
        "topic": "assessment",
        "text": "Map the people, processes, technology and third parties behind each important business service.",
        "clock_hours": null
      },
      {
        "topic": "board_duty",
        "text": "Have the board approve the self-assessment.",
        "clock_hours": null
      },
      {
        "topic": "third_parties",
        "text": "Keep outsourcing registers and exit plans.",
        "clock_hours": null
      },
      {
        "topic": "incident_reporting",
        "text": "From 18 March 2027, send standardised operational incident reports and notify material third party arrangements.",
        "clock_hours": null
      }
    ],
    "assurance": {
      "kind": "none",
      "note": "No certification."
    },
    "iso27001": {
      "relation": "not_a_substitute",
      "note": "Vendor assurance (SOC 2 Type II, ISO 27001, ISO 22301) is routinely requested but is not a regulatory substitute."
    },
    "soc2": {
      "relation": "not_a_substitute",
      "note": "SOC 2 Type II is routinely requested from vendors but is not a regulatory substitute."
    },
