[
  {
    "key": "SA-01",
    "jurisdiction": "SA",
    "zone": null,
    "short_name": "Saudi PDPL",
    "official_name": "Personal Data Protection Law (Royal Decree M/19 of 2021, amended by M/148 of 2023), its Implementing Regulations and the Regulation on Personal Data Transfer outside the Kingdom",
    "issuer": "Kingdom of Saudi Arabia (Royal Decree)",
    "regulator": "Saudi Data and AI Authority (SDAIA)",
    "kinds": [
      "privacy"
    ],
    "topic_column": "privacy",
    "force": "law",
    "state": "in_force",
    "state_note": "In force since 14 September 2023 and enforced since the grace period ended on 14 September 2024; SDAIA had announced 48 enforcement decisions by January 2026. Draft amendments to the Implementing Regulations published 6 October 2026 (consultation closed 5 November 2026) are not final.",
    "tier": "most_should_know",
    "applies_to": "Any processing of personal data that takes place in the Kingdom, and processing of Saudi residents' data by entities abroad.",
    "duties": [
      {
        "topic": "registration",
        "text": "Register on SDAIA's National Data Governance Platform if you are one of the defined controllers.",
        "clock_hours": null
      },
      {
        "topic": "consent",
        "text": "Have a lawful basis, mainly consent, publish a privacy notice, honour data subject rights, keep records of processing and run impact assessments.",
        "clock_hours": null
      },
      {
        "topic": "officer",
        "text": "Appoint a data protection officer in the defined cases: large scale or sensitive processing, regular monitoring, or a public body.",
        "clock_hours": null
      },
      {
        "topic": "breach_notice",
        "text": "Notify SDAIA through the National Data Governance Platform within 72 hours of a breach that may harm people or their rights, and tell the people affected without undue delay.",
        "clock_hours": 72
      },
      {
        "topic": "transfers",
        "text": "Send data abroad only under the transfer regulation: adequacy, or safeguards such as standard clauses or binding rules, with a risk assessment.",
        "clock_hours": null
      },
      {
        "topic": "penalties",
        "text": "Fines reach SAR 5 million, doubled for repeat breaches, and unlawful disclosure of sensitive data can be a crime.",
        "clock_hours": null
      }
    ],
    "assurance": {
      "kind": "registration",
      "note": "Defined controllers register on the National Data Governance Platform; SDAIA can license accreditation bodies but there is no general certificate."
    },
    "iso27001": {
      "relation": "helps_partially",
      "note": "Not referenced; security controls also have to meet National Cybersecurity Authority rules where those apply."
    },
    "soc2": {
      "relation": "helps_partially",
      "note": "Not referenced; security controls also have to meet National Cybersecurity Authority rules where those apply."
    },
