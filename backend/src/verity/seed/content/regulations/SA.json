  {
    "key": "SA-05",
    "jurisdiction": "SA",
    "zone": null,
    "short_name": "NCNICC",
    "official_name": "NCA Non-CNI Private Sector Entities Cybersecurity Controls (NCNICC-1:2025)",
    "issuer": "National Cybersecurity Authority (NCA)",
    "regulator": "National Cybersecurity Authority (NCA)",
    "kinds": [
      "cybersecurity"
    ],
    "topic_column": "security_baseline",
    "force": "regulator_rule",
    "state": "in_force",
    "state_note": "Binding once NCA notifies an entity; other private entities are expected to use it as good practice. The text sets no compliance deadline and carries no adoption date, and who has been notified is not public.",
    "tier": "most_should_know",
    "applies_to": "Private companies in the Kingdom that are not critical infrastructure and that NCA notifies, in two size categories: A, large (more than 250 full-time staff or more than SAR 200 million revenue), and B, small and medium (6 to 249 staff or SAR 3 million to 200 million revenue). Micro entities, the non-governmental sector, government and critical infrastructure are excluded.",
    "duties": [
      {
        "topic": "baseline",
        "text": "Category B: apply the 26 binding Cybersecurity Defense controls, including asset management, MFA for remote access and email, malware protection, email filtering with SPF, DKIM and DMARC, encryption, tested backups, patching and logging.",
        "clock_hours": null
      },
      {
        "topic": "baseline",
        "text": "Category A: apply all 65 binding controls, adding policies, risk methodology, awareness, third party contract clauses, cloud and hosting rules, penetration testing and web application protection.",
        "clock_hours": null
      },
      {
        "topic": "officer",
        "text": "Category A: run a cybersecurity function independent of IT that reports to the head of the entity, led and staffed in sensitive roles by full-time qualified Saudi nationals.",
        "clock_hours": null
      },
      {
        "topic": "third_parties",
        "text": "Category A: subscribe to an NCA-licensed managed security operations centre.",
        "clock_hours": null
      },
      {
        "topic": "incident_reporting",
        "text": "Report cybersecurity incidents to NCA and share threat information with it.",
        "clock_hours": null
      },
      {
        "topic": "assessment",
        "text": "Category A: have compliance reviewed independently as NCA approves; NCA can assess any notified entity by its own method and add controls.",
        "clock_hours": null
      }
    ],
    "assurance": {
      "kind": "none",
