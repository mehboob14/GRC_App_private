# Verity frontend environment — copy to .env.local for local overrides.

# Mock Service Worker mode. A dev convenience only — defaults OFF.
# When off (default), the app talks to the real API through the Vite dev
# proxy: /api -> http://127.0.0.1:8001 (see vite.config.ts).
# Set to "true" to run the UI against the in-browser MSW mocks instead.
VITE_USE_MOCKS=false
