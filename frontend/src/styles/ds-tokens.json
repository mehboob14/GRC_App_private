  "type": {
    "fonts": { "display": "Sora", "ui": "Inter" },
    "weights": { "sora": [600, 700, 800], "inter": [400, 500, 600, 700] },
    "styles": {
      "display-hero": { "family": "Sora", "weight": 800, "size": 52, "lineHeight": 52, "letterSpacing": -1.56, "usage": "gauge & hero numerals only" },
      "display-xl": { "family": "Sora", "weight": 800, "size": 32, "lineHeight": 38, "letterSpacing": -0.8, "usage": "marketing panels only" },
      "heading-xl": { "family": "Sora", "weight": 800, "size": 28, "lineHeight": 34, "letterSpacing": -0.7, "usage": "auth headline" },
      "heading-lg": { "family": "Sora", "weight": 800, "size": 24, "lineHeight": 30, "letterSpacing": -0.48, "usage": "page title, one per page" },
      "heading-md": { "family": "Sora", "weight": 800, "size": 20, "lineHeight": 26, "letterSpacing": -0.4, "usage": "drawer & modal titles" },
      "heading-sm": { "family": "Sora", "weight": 700, "size": 18, "lineHeight": 24, "letterSpacing": -0.18, "usage": "large section titles" },
      "title-md": { "family": "Sora", "weight": 700, "size": 14, "lineHeight": 20, "letterSpacing": 0, "usage": "card titles" },
      "title-sm": { "family": "Sora", "weight": 700, "size": 13, "lineHeight": 18, "letterSpacing": 0, "usage": "sub-card titles" },
      "body-lg": { "family": "Inter", "weight": 400, "size": 14, "lineHeight": 22, "letterSpacing": 0, "usage": "prose blocks" },
      "body-md": { "family": "Inter", "weight": 400, "size": 13, "lineHeight": 20, "letterSpacing": 0, "usage": "default UI text, table cells, inputs" },
      "body-sm": { "family": "Inter", "weight": 400, "size": 12, "lineHeight": 17, "letterSpacing": 0, "usage": "secondary cells, helper text" },
      "label-md": { "family": "Inter", "weight": 600, "size": 13, "lineHeight": 16, "letterSpacing": 0, "usage": "button & tab labels" },
      "label-sm": { "family": "Inter", "weight": 600, "size": 12, "lineHeight": 15, "letterSpacing": 0, "usage": "form labels, facets" },
      "caption": { "family": "Inter", "weight": "400-600", "size": 11, "lineHeight": 15, "letterSpacing": 0, "usage": "timestamps, meta, badges" },
      "overline": { "family": "Inter", "weight": 700, "size": 10, "lineHeight": 14, "letterSpacing": 0.5, "transform": "uppercase", "usage": "table headers and eyebrows; always at text-secondary or darker, never text-faint" },
      "code-chip": { "family": "Sora", "weight": 700, "size": 12, "lineHeight": 16, "letterSpacing": 0, "usage": "entity codes, accent colored" },
      "numeral-lg": { "family": "Sora", "weight": 800, "size": 28, "lineHeight": 32, "letterSpacing": -0.56, "usage": "KPI values" },
      "numeral-md": { "family": "Sora", "weight": 800, "size": 24, "lineHeight": 28, "letterSpacing": -0.48, "usage": "stat cards" },
      "numeral-sm": { "family": "Sora", "weight": 800, "size": 20, "lineHeight": 24, "letterSpacing": -0.2, "usage": "inline stats" }
    },
    "rules": [
      "One heading-lg per page — the page title.",
      "Hierarchy inside a component: weight and color first, size second.",
      "Links inherit their context size; text-link color + 600.",
      "font-variant-numeric: tabular-nums in all tables, KPIs, counts and dates.",
      "Unit suffixes: 50% size, Inter 600, text-faint."
    ]
  },
