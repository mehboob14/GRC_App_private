# Public canonical origin for the static site, without a trailing slash.
SITE_URL=https://www.example.com
# Origin of the Verity application; Start trial and Sign in open its /sign-up and /sign-in routes.
APP_URL=https://runwaydream.com

# Optional. HTTPS endpoint that receives demo requests as JSON (POST, no cookies).
# Unset: the demo form explains that requests are not being sent yet.
# Remember to add its origin to the CSP connect-src on your host (see nginx.conf).
NEXT_PUBLIC_DEMO_ENDPOINT=
# Optional. HTTPS endpoint for "Was this page helpful?" votes on docs pages. Unset: hidden.
NEXT_PUBLIC_FEEDBACK_ENDPOINT=

# Optional. Links to approved, published policies. Unset: no legal links are shown.
PRIVACY_URL=
TERMS_URL=
