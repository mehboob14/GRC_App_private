# Copy to .env.production ON THE SERVER and fill in. Never commit the filled copy.
#
# Generate every secret on the machine that will hold it, so no real value ever
# travels through a chat window, a ticket, or a shell history on your laptop.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# `production` turns on the hard validators: dev-default SECRET_KEY and
# APP_ENCRYPTION_KEY are refused, /docs and /redoc are disabled, and logs switch
# to JSON. The process will not start if anything below is left at a dev value.
ENV=production

# ---------------------------------------------------------------------------
# Secrets  —  generate with the commands in the comments
# ---------------------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Format is <key_id>:<urlsafe-base64 of 32 bytes>, key_id matching ^[a-z0-9][a-z0-9_-]{0,31}$
#   python -c "import base64,os; print('k1:' + base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# This encrypts TOTP secrets and connector credentials. If it is lost, every stored
# secret becomes unreadable — there is no recovery. If it is ever rotated, the old
# value must move to APP_ENCRYPTION_KEYS_PREVIOUS or the same thing happens.
APP_ENCRYPTION_KEY=
# APP_ENCRYPTION_KEYS_PREVIOUS=

# ---------------------------------------------------------------------------
# Database  —  two roles, deliberately
# ---------------------------------------------------------------------------
# The app connects as verity_app (NOSUPERUSER, NOBYPASSRLS). Migrations connect as
# verity_owner. They MUST differ: a superuser or table owner bypasses row-level
# security, so an app running as the owner has no tenant isolation at all, silently.
# Settings refuses to construct if these are equal when ENV=production.
#
#   openssl rand -base64 24
DATABASE_OWNER_USER=verity_owner
DATABASE_OWNER_PASSWORD=
DATABASE_APP_USER=verity_app
DATABASE_APP_PASSWORD=
DATABASE_READONLY_USER=verity_readonly
DATABASE_READONLY_PASSWORD=
DATABASE_NAME=verity

# Hostname is the compose service name, not localhost. Both need the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://verity_app:CHANGE_ME@postgres:5432/verity
DATABASE_MIGRATION_URL=postgresql+asyncpg://verity_owner:CHANGE_ME@postgres:5432/verity

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Only the /readyz probe and Celery use it today. /readyz returns 503 when it is
# unreachable, so it stays in the stack.
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# Must be `local`. core/storage.py:S3ObjectStore is a stub whose every method
# raises NotImplementedError, so setting `s3` makes each evidence upload a 500 —
# MinIO being up and the bucket existing changes nothing.
#
# `local` writes to .data/objects inside the container. The compose file mounts
# the `evidence-data` volume there, which is what makes it survive a rebuild.
# Switch to `s3` only once that driver is actually written.
STORAGE_DRIVER=local

# Unused while the driver is `local`, kept so MinIO and the bucket stay
# provisioned and the switch is a one-line change later.
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=verity-evidence
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
#   openssl rand -base64 24
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Public URL
# ---------------------------------------------------------------------------
# Verification, password-reset and invite links are minted against this. Leave it at
# the default and real users receive links pointing at localhost.
FRONTEND_BASE_URL=https://runwaydream.com

# Not needed: the frontend calls /api/v1 same-origin through its own nginx, so no
# browser request is ever cross-origin. Set this only if an external client appears.
# CORS_ALLOW_ORIGINS=["https://runwaydream.com"]

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Without SMTP the mailer is a no-op, so self-service signup dead-ends: the account
# is created but login is refused until the emailed verification link is followed.
# The provider-plane admin-invite path returns its accept_url in the response body
# and self-verifies, so first-tenant bootstrap works without mail — but nothing else
# does. Use a transactional provider here, not a personal mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
