# Copy to infra/docker/.env.website ON THE SERVER. Nothing here is secret, but the filled-in
# copy is not committed: it is per server.
#
# These values are baked into the pages at build time. After changing one, run
# infra/scripts/deploy-site.sh again.

# The address the site is served from: HTTPS, no trailing slash, no path. It becomes the
# canonical links, the sitemap and robots.txt.
#
# Temporary address, needs no DNS change: sslip.io answers name.<server ip with dashes>.sslip.io
# with that IP. Replace with the real hostname (https://www.runwaydream.com or similar) when
# its DNS record exists.
SITE_URL=https://website.37-60-228-227.sslip.io

# Where the platform lives. Start trial and Sign in open its /sign-up and /sign-in.
APP_URL=https://runwaydream.com

# Optional. Leave empty until they exist (the site hides or explains what is not configured).
# HTTPS endpoint that receives demo requests as JSON. Its origin must also be added to the
# Content-Security-Policy connect-src in website/nginx.conf.
NEXT_PUBLIC_DEMO_ENDPOINT=
# HTTPS endpoint for "Was this page helpful?" votes on the docs pages.
NEXT_PUBLIC_FEEDBACK_ENDPOINT=
# Links to approved, published policies. No legal links are shown while these are empty.
PRIVACY_URL=
TERMS_URL=
