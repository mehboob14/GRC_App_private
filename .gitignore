# Secrets. .env.example is the committed template; .env never is.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.importlinter_cache/

# Node
node_modules/
dist-ssr/
*.local

# Editors and OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Celery
celerybeat-schedule*

# Word/Excel lock files (created while a doc is open)
~$*
