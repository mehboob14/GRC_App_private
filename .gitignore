# Secrets. The *.example templates are committed; the filled-in files never are.
# `.env.*` catches .env.production and .env.local; the negations put the templates
# back, including infra/docker/.env.production.example — without the second one,
# `.env.*` swallows it and the server deploy ships with no documented config surface.
.env
.env.*
!.env.example
!.env.*.example

# Runtime data written by STORAGE_DRIVER=local — uploaded evidence files. Real
# customer documents in a compliance product; never in version control.
.data/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.importlinter_cache/

# Node
node_modules/
dist-ssr/
*.local

# Editors and OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Celery
celerybeat-schedule*

# Word/Excel lock files (created while a doc is open)
~$*
