# Copy to .env at the repository root. Never commit .env.
#
#   cp .env.example .env
#
# One file configures the Docker stack, the backend, and the workers. The defaults here
# are development values and are deliberately unusable in staging or production: with
# ENV=staging or ENV=production, Settings refuses to construct while SECRET_KEY or
# APP_ENCRYPTION_KEY still holds its default, or while the application and migration
# roles are the same.

# --- environment -------------------------------------------------------------------
ENV=local
LOG_LEVEL=INFO
# json | console. Defaults to console locally and json when deployed.
# LOG_FORMAT=console

# --- secrets -----------------------------------------------------------------------
# Signs session tokens. Rotating it invalidates every session.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-before-deploying

# Master key for application-layer encryption of connector credentials, MFA secrets,
# and portal tokens. Format: <key_id>:<urlsafe-base64 32 bytes>
#   python -c "import base64,os; print('k1:'+base64.urlsafe_b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=dev:dmVyaXR5LWxvY2FsLWRldmVsb3BtZW50LWtleS0zMmI=

# Retired master keys, comma-separated, kept so values encrypted under them still
# decrypt. This is what makes rotation possible without re-encrypting every row.
# APP_ENCRYPTION_KEYS_PREVIOUS=

# --- database ----------------------------------------------------------------------
# The application connects as a role that owns nothing and holds no BYPASSRLS.
DATABASE_URL=postgresql+asyncpg://verity_app:verity_app@localhost:5432/verity
# Migrations connect as the role that owns the schema. Must differ from the above.
DATABASE_MIGRATION_URL=postgresql+asyncpg://verity_owner:verity_owner@localhost:5432/verity
DATABASE_APP_ROLE=verity_app
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_ECHO=false

# Consumed by infra/docker/docker-compose.yml when creating the cluster and its roles.
DATABASE_NAME=verity
DATABASE_PORT=5432
DATABASE_OWNER_USER=verity_owner
DATABASE_OWNER_PASSWORD=verity_owner
DATABASE_APP_USER=verity_app
DATABASE_APP_PASSWORD=verity_app
DATABASE_READONLY_USER=verity_readonly
DATABASE_READONLY_PASSWORD=verity_readonly

# --- redis and jobs ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
# Both default to REDIS_URL.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
CELERY_TASK_DEFAULT_QUEUE=verity

# --- object storage ----------------------------------------------------------------
# Evidence files live here, never in Postgres. Set S3_ENDPOINT_URL for MinIO; leave it
# unset for real S3.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=verity-evidence
S3_ACCESS_KEY_ID=verity-minio
S3_SECRET_ACCESS_KEY=verity-minio-secret
S3_USE_PATH_STYLE=true
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- AI ----------------------------------------------------------------------------
# AI drafts; humans decide (rule 8). No AI features until Phase 2 — this configures the
# client only.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.0
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
# Your OpenAI key. With it, evidence is read by the model: suggested controls with SOC 2
# requirement references and a maturity score, and a maturity check when evidence is
# uploaded under a control. A reasoning model such as gpt-5.5 can be set in AI_MODEL (the
# temperature is then left out automatically). Without a key an offline matcher is used.
# AI_API_KEY=

# --- tracing -----------------------------------------------------------------------
# These names are the ones the LangSmith SDK reads for itself, so this file configures
# both Settings and the SDK and the two cannot disagree.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=verity
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- api ---------------------------------------------------------------------------
# Comma-separated. Empty means no CORS middleware at all.
# CORS_ALLOW_ORIGINS=http://localhost:5173

# Outbound email (SMTP). Leave SMTP_HOST empty to disable sending (local/test no-op).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Verity
